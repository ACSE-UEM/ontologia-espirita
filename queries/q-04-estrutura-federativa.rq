# Como está montada a estrutura federativa que o catálogo conhece?
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX esp: <https://w3id.org/ontologia-espirita/v1#>

SELECT ?orgao ?nomeLocal ?vinculo ?dentroDe
WHERE {
  ?umOrgao a/rdfs:subClassOf* esp:Orgao ;
           rdfs:label ?orgao .
  OPTIONAL { ?umOrgao esp:nomeLocal ?nomeLocal }
  OPTIONAL {
    ?umOrgao esp:parteDe|esp:orgaoInternoDe ?superior .
    ?superior rdfs:label ?dentroDe .
    BIND(IF(EXISTS { ?umOrgao esp:orgaoInternoDe ?superior },
            "órgão interno de",
            "parte de") AS ?vinculo)
  }
}
ORDER BY ?orgao
