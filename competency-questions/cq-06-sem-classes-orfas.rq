# CQ-06: Toda classe da ontologia (exceto as 5 classes de topo intencionais)
# tem pelo menos um rdfs:subClassOf?
# (violação = uma classe sem nenhum rdfs:subClassOf, exceto as raízes esperadas)
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX esp: <https://w3id.org/ontologia-espirita/v1#>

SELECT ?classe
WHERE {
  ?classe a owl:Class .
  FILTER(?classe != esp:Organizacao && ?classe != esp:Pessoa && ?classe != esp:Atividade && ?classe != esp:Localizacao && ?classe != esp:AreaDeAtuacao)
  FILTER NOT EXISTS { ?classe rdfs:subClassOf ?qualquerCoisa }
}
